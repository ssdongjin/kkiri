# Supabase 프로젝트 Settings > API에서 복사하세요. 값이 없으면 정적 데모와 혼밥 추천을 사용할 수 있습니다.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# 선택 사항: 실제 주변 식당 검색 제공 서버 (생략하면 아래 공개 서버를 사용)
# VITE_PHOTON_URL=https://photon.komoot.io
# VITE_OVERPASS_URL=https://overpass.private.coffee/api/interpreter
